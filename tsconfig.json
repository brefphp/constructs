{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2019",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "esModuleInterop": true,
        "allowJs": true,
        "skipLibCheck": true,
        // Useful for debugging (stack traces)
        "sourceMap": true,
        "resolveJsonModule": true,
        "strictNullChecks": true,
        "types": ["node"]
    },
    "include": ["src"]
}
